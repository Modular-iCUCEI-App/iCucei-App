{
  "expo": {
    "name": "iCucei",
    "slug": "iCucei",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/iCuceiLogo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.k1000a-sc.iCucei"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "assets/iCuceiLogo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.k1000a_sc.iCucei"
    },
    "web": {
      "favicon": "assets/iCuceiLogo.png"
    },
    "plugins": [
      "expo-video",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "assets/iCuceiLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
